# App
APP_ENV=development
APP_SECRET_KEY=changeme-use-a-real-secret-key
APP_DOMAIN=localhost:8000
DEBUG=true

# LLM - Choose ONE (both have free tiers)
# Option 1: Groq (recommended - free tier with Llama 3.1/3.3)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-8b-8192

# Option 2: Google Gemini (free tier available)
GOOGLE_API_KEY=...

# LLM Provider Selection
LLM_PROVIDER=groq  # groq or google

# Database (SQLite - free, local)
DATABASE_URL=sqlite+aiosqlite:///./support_agent.db

# Optional MongoDB (used by spec-aligned ticket/alarm storage fallback)
MONGODB_URI=
MONGODB_DATABASE=support_agent_demo

# ChromaDB (free, local vector store)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Embedding Model (HuggingFace - free, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Voice (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email channel (Gmail IMAP/SMTP)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Demo channel behavior
ENABLE_EMAIL_POLLER=false
EMAIL_POLL_INTERVAL_SECONDS=60

# Agent behavior
ESCALATION_CONFIDENCE_THRESHOLD=0.4
MAX_TURNS_BEFORE_ESCALATE=6
DEFAULT_MACHINE=KHS_Filler
